rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function esDueno(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // La foto de perfil va dentro del documento en Base64 (unos 30 KB).
    // Se limita a 200 KB para que nadie pueda llenar el documento.
    function fotoValida() {
      return !('foto' in request.resource.data)
        || (request.resource.data.foto is string && request.resource.data.foto.size() < 200000);
    }

    // Perfil: solo lo lee y lo cambia su dueño.
    match /users/{uid} {
      allow read, delete: if esDueno(uid);
      allow create, update: if esDueno(uid) && fotoValida();

      // Todo lo que cuelga del perfil (agua, dieta, rutinas...).
      match /{documento=**} {
        allow read, write: if esDueno(uid);
      }
    }

    // Todo lo demás queda cerrado.
  }
}
